# URL canonique du site, sans slash final.
# Exemple : https://www.selection-neuf.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# URL du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publishable (publique). Utilisée pour l'insertion des leads via la policy RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Clé secret (service). NE JAMAIS committer ni exposer côté client.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Google Ads (conversion lead) ---
# Label de l'action de conversion (partie après le "/" du send_to fourni par
# Google Ads, ex : AW-18481078166/AbCdEfGhIjKlMnOp -> AbCdEfGhIjKlMnOp).
# Laisser vide tant que le label n'est pas créé dans Google Ads.
NEXT_PUBLIC_GADS_CONVERSION_LABEL=
